rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(memberPath()); }
    function role() { return get(memberPath()).data.role; }
    function approved() { return hasProfile() && role() != 'pending'; }
    function admin() { return approved() && role() in ['owner', 'monthly_manager', 'monitor']; }
    function owner() { return approved() && role() == 'owner'; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || approved());
      allow list: if approved();
      // New sign-ups may create only a pending profile for themselves.
      allow create: if admin() || (self(uid) && request.resource.data.role == 'pending' && request.resource.data.active == false);
      allow update: if admin();
      allow delete: if owner();
    }

    match /dailyMeals/{docId} {
      allow read: if approved();
      allow create: if approved() && (admin() || request.resource.data.uid == request.auth.uid);
      allow update: if approved() && (admin() || (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid));
      allow delete: if approved() && (admin() || resource.data.uid == request.auth.uid);
    }
    match /guestMeals/{docId} {
      allow read: if approved();
      allow create: if approved() && (admin() || request.resource.data.uid == request.auth.uid);
      allow update: if approved() && (admin() || (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid));
      allow delete: if approved() && (admin() || resource.data.uid == request.auth.uid);
    }
    match /payments/{docId} {
      allow read: if approved();
      allow create: if approved() && (admin() || request.resource.data.uid == request.auth.uid);
      allow update: if approved() && (admin() || (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid));
      allow delete: if approved() && (admin() || resource.data.uid == request.auth.uid);
    }
    match /expenses/{docId} {
      allow read: if approved();
      allow create, update, delete: if admin();
    }
    match /settings/{docId} {
      allow read: if approved();
      allow create, update, delete: if admin();
    }
  }
}
